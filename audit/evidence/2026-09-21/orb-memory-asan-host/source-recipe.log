   293	/// `zig` next to the running `mo`, else the first on PATH.
   294	pub fn findZig(gpa: std.mem.Allocator, io: Io, environ: *const std.process.Environ.Map) !?[]const u8 {
   295	    const cwd = Io.Dir.cwd();
   296	    if (std.process.executableDirPathAlloc(io, gpa)) |dir| {
   297	        const beside = try std.fs.path.join(gpa, &.{ dir, "zig" });
   298	        if (cwd.access(io, beside, .{})) |_| return beside else |_| {}
   299	    } else |_| {}
   300	    const path = environ.get("PATH") orelse return null;
   301	    var it = std.mem.tokenizeScalar(u8, path, ':');
   302	    while (it.next()) |entry| {
   303	        const candidate = try std.fs.path.join(gpa, &.{ entry, "zig" });
   304	        if (cwd.access(io, candidate, .{})) |_| return candidate else |_| {}
   305	    }
   306	    return null;
