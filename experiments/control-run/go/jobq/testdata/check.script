# The program-level check for jobq: jobq check plays every line through a
# real socket. Lines are <token> <method> <path> [<json>]; a token of - sends
# no authorization header; `clock +<ms>` moves the service's clock.
- GET /health
- POST /jobs {"queue":"emails","payload":"hi","max_attempts":2}
prod POST /jobs {"queue":"emails","payload":"hello","max_attempts":2}
prod POST /jobs {"queue":"emails","payload":"second","max_attempts":1}
prod POST /jobs {"queue":"bad queue","payload":"x","max_attempts":1}
prod POST /jobs {"queue":"emails","payload":"x"}
prod GET /jobs/j_1
prod GET /jobs/j_9
clock +1000
w1 POST /queues/emails/lease {"lease_ms":500}
w2 POST /queues/emails/lease {"lease_ms":500}
w2 POST /queues/emails/lease
w2 POST /jobs/j_1/ack
clock +500
w2 POST /queues/emails/lease {"lease_ms":1000}
w1 POST /jobs/j_1/ack
w2 POST /jobs/j_1/ack
w2 POST /jobs/j_1/ack
prod DELETE /jobs/j_2
prod POST /jobs {"queue":"sms","payload":"text me","max_attempts":3}
w3 POST /queues/sms/lease {"lease_ms":1000}
prod DELETE /jobs/j_3
restart
clock +2000
w3 POST /jobs/j_3/ack
w4 POST /queues/sms/lease
w4 POST /jobs/j_3/fail {"reason":"smtp down"}
prod POST /jobs {"queue":"emails","payload":"after restart","max_attempts":3}
prod GET /jobs
- GET /health
prod GET /jobs/j_2
prod PUT /jobs
prod GET /nope
