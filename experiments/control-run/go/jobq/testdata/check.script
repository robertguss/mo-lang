# The program-level check for jobq: jobq check plays every line through a
# real socket. Lines are <token> <method> <path> [<json>]; a token of - sends
# no authorization header; `clock +<ms>` moves the service's clock.
- GET /health
- POST /jobs {"queue":"emails","payload":"hi","max_tries":2}
prod POST /jobs {"queue":"emails","payload":"hello","max_tries":2}
prod POST /jobs {"queue":"emails","payload":"second","max_tries":1}
prod POST /jobs {"queue":"bad queue","payload":"x","max_tries":1}
prod POST /jobs {"queue":"emails","payload":"x"}
prod GET /jobs/j_1
prod GET /jobs/j_9
clock +1000
w1 POST /queues/emails/lease {"lease_ms":500}
w2 POST /queues/emails/lease {"lease_ms":500}
w2 POST /queues/emails/lease
w2 POST /jobs/j_1/ack
clock +500
w2 POST /queues/emails/lease {"lease_ms":1000}
w1 POST /jobs/j_1/ack
w2 POST /jobs/j_1/ack
w2 POST /jobs/j_1/ack
prod DELETE /jobs/j_2
prod POST /jobs {"queue":"sms","payload":"text me","max_tries":3}
w3 POST /queues/sms/lease {"lease_ms":1000}
prod DELETE /jobs/j_3
restart
clock +2000
w3 POST /jobs/j_3/ack
w4 POST /queues/sms/lease
w4 POST /jobs/j_3/fail {"reason":"smtp down"}
prod POST /jobs {"queue":"emails","payload":"after restart","max_tries":3}
# scheduled jobs, backoff, and retry
prod POST /jobs {"queue":"later","payload":"delayed","max_tries":2,"delay_ms":5000}
prod POST /jobs {"queue":"later","payload":"backoff","max_tries":2,"backoff_ms":2000}
prod POST /jobs {"queue":"later","payload":"old name","max_attempts":2}
prod POST /jobs {"queue":"later","payload":"x","max_tries":1,"delay_ms":86400001}
prod POST /jobs {"queue":"later","payload":"x","max_tries":1,"backoff_ms":1.5}
w5 POST /queues/later/lease {"lease_ms":1000}
w5 POST /jobs/j_6/fail {"reason":"try later"}
w5 POST /queues/later/lease
prod POST /jobs/j_6/retry
prod GET /jobs?state=scheduled
- GET /health
clock +2000
w5 POST /queues/later/lease {"lease_ms":1000}
clock +1000
prod GET /jobs/j_6
prod POST /jobs/j_6/retry
prod POST /jobs/j_6/retry
prod GET /jobs/j_6/retry
restart
clock +2000
w6 POST /queues/later/lease
w6 POST /queues/later/lease
prod POST /jobs/j_9/retry
prod GET /jobs
- GET /health
prod GET /jobs/j_2
# /queues: every queue that holds a job, and a delete that empties one
prod GET /queues
- GET /queues
prod POST /jobs {"queue":"only","payload":"alone","max_tries":1}
prod GET /queues
prod DELETE /jobs/j_7
prod GET /queues
prod PUT /jobs
prod GET /nope
# the board fails after a write reaches the disk and restarts itself
- GET /health
crash
prod POST /jobs {"queue":"crash","payload":"on disk","max_tries":1}
- GET /health
prod GET /jobs?queue=crash
crash
w7 POST /queues/crash/lease {"lease_ms":1000}
prod GET /jobs?queue=crash
w7 POST /jobs/j_8/ack
- GET /health
restart
- GET /health
prod GET /jobs/j_8
# idempotent creates: a key names one job in its queue
prod POST /jobs {"queue":"keyed","key":"order-1","payload":"once","max_tries":1}
prod POST /jobs {"queue":"keyed","key":"order-1","payload":"twice","max_tries":5}
prod POST /jobs {"queue":"other","key":"order-1","payload":"elsewhere","max_tries":1}
prod POST /jobs {"queue":"keyed","key":"bad key","payload":"x","max_tries":1}
prod POST /jobs {"queue":"keyed","key":"","payload":"x","max_tries":1}
prod GET /jobs?queue=keyed&key=order-1
prod GET /jobs?queue=keyed&key=order-2
prod GET /jobs?key=order-1
w8 POST /queues/keyed/lease
w8 POST /jobs/j_9/ack
# a day later the done and dead jobs are archived, and still read by id
clock +86400000
- GET /health
- GET /health
prod GET /jobs/j_9
prod GET /jobs?queue=keyed
prod GET /queues
prod POST /jobs {"queue":"keyed","key":"order-1","payload":"thrice","max_tries":1}
prod POST /jobs/j_9/retry
restart
prod GET /jobs?queue=keyed&key=order-1
- GET /health
prod DELETE /jobs/j_9
prod GET /jobs/j_9
prod POST /jobs {"queue":"keyed","key":"order-1","payload":"again","max_tries":1}
restart
prod POST /jobs {"queue":"keyed","key":"order-1","payload":"again","max_tries":1}
- GET /health
