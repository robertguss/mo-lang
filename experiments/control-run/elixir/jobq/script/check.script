# The program-level check: every line is played through `jobq client` over a
# real socket against a service on a directory of its own.
#
#   <token> <method> <path> [<json>]

# Two jobs into the emails queue, and the ways of reading them back.
alice POST /jobs {"queue":"emails","payload":"welcome","max_tries":2}
alice POST /jobs {"queue":"emails","payload":"receipt","max_tries":1}
alice GET /jobs/j_1
alice GET /jobs
alice GET /jobs?queue=emails&state=queued

# A worker takes the oldest of the queue and acks it.
bob POST /queues/emails/lease {"lease_ms":60000}
bob POST /jobs/j_1/ack
alice GET /jobs/j_1

# The second job has one try, and a fail takes it to dead.
bob POST /queues/emails/lease
bob POST /jobs/j_2/fail {"reason":"smtp said no"}
alice GET /jobs?state=dead

# Nothing is queued in emails now.
bob POST /queues/emails/lease

# A leased job is not deleted; a queued one is.
alice POST /jobs {"queue":"reports","payload":"nightly","max_tries":3}
carol POST /queues/reports/lease
alice DELETE /jobs/j_3
carol POST /jobs/j_3/ack
alice DELETE /jobs/j_3
alice GET /jobs/j_3

# A job created with a delay waits in scheduled until its run_at, and no
# worker leases it before then.
alice POST /jobs {"queue":"digests","payload":"tomorrow","max_tries":3,"delay_ms":3600000}
alice GET /jobs/j_4
dave POST /queues/digests/lease
alice GET /jobs?state=scheduled

# A backoff puts a failed job back in scheduled rather than queued, and a
# scheduled job is deleted like a queued one.
alice POST /jobs {"queue":"retries","payload":"flaky","max_tries":3,"backoff_ms":600000}
dave POST /queues/retries/lease
dave POST /jobs/j_5/fail {"reason":"connection reset"}
dave POST /queues/retries/lease
alice DELETE /jobs/j_5

# A dead job goes back to its queue with a retry, its tries at 0 and its
# reason dropped, and is leased again. A retry of anything else is 409.
alice POST /jobs/j_2/retry
alice POST /jobs/j_2/retry
bob POST /queues/emails/lease
alice POST /jobs/j_2/retry
alice POST /jobs/j_1/retry
alice POST /jobs/j_4/retry
alice POST /jobs/j_9/retry

# What the API refuses.
alice POST /jobs {"queue":"emails"}
alice POST /jobs {"queue":"em ails","payload":"x","max_tries":1}
alice POST /jobs {"queue":"emails","payload":"x","max_tries":1,"extra":true}
alice POST /jobs nonsense
alice POST /jobs {"queue":"emails","payload":"x","max_attempts":1}
alice POST /jobs {"queue":"emails","payload":"x","max_tries":1,"delay_ms":-1}
alice POST /jobs {"queue":"emails","payload":"x","max_tries":1,"delay_ms":"soon"}
alice POST /jobs {"queue":"emails","payload":"x","max_tries":1,"backoff_ms":3600001}
alice POST /queues/emails/lease {"lease_ms":1}
alice GET /jobs?state=sideways
alice PUT /jobs
alice GET /jobs/j_1/ack
alice PUT /jobs/j_1/retry
alice GET /nowhere
alice POST /jobs/j_9/ack
bob POST /jobs/j_1/ack

# The counters.
anyone GET /health
