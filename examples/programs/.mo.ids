        { "id": "0fbeae684e97", "name": "test \"a job made with a delay is scheduled until its run_at, and queued at the first look after it\"", "hash": "a711a5b71489a3e9" },
        { "id": "27206f7da115", "name": "test \"a fail with backoff schedules the job at now plus the backoff, and a fail on the last try is dead\"", "hash": "aed6d5936bc244bf" },
        { "id": "d1ccdb9a5fce", "name": "test \"a lease that runs out with a backoff is scheduled, and without one queued\"", "hash": "e046667fd09dfc06" },
