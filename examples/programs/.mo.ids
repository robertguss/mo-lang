        { "id": "bba987079727", "name": "fn create_keyed", "hash": "552be48dd4c06fd8" },
        { "id": "79fc9e849f03", "name": "fn one_done", "hash": "7d7a106a5964fc40" },
        { "id": "dcb73d240b33", "name": "test \"a job made is found by its id, and its record is written under that id\"", "hash": "bb0edcefd3572952" },
        { "id": "efe0cef0847f", "name": "test \"a lease hands out the oldest queued job of its queue, and Empty when none is queued\"", "hash": "68f5ff8ad39c0b30" },
        { "id": "792d9c48b5c5", "name": "test \"two workers race for one job: exactly one holds it, and only the holder acks it\"", "hash": "290b58a7e842c18a" },
        { "id": "18ef9222b451", "name": "test \"a lease that runs out is leased again with tries at 2, and one that runs out on its last try is dead\"", "hash": "e2b40fcedf68f67f" },
        { "id": "375ce4f02bbb", "name": "test \"a job made with a delay is scheduled, is not leased before its run_at, and is leased after it\"", "hash": "42e75d8d98b8fa45" },
        { "id": "e6a7e5ac267c", "name": "test \"a fail with a backoff schedules the job, and a lease before its run_at is Empty\"", "hash": "93b312e4631a67e2" },
        { "id": "b49a44540477", "name": "test \"a lease that runs out with a backoff leaves the job scheduled until its run_at\"", "hash": "480164a45b94f81c" },
        { "id": "86804b9b72b7", "name": "test \"a retry queues a dead job with no tries and its place by id, and refuses any other state\"", "hash": "5500414fb611711e" },
        { "id": "834eae7bdff6", "name": "test \"a delete takes a queued, scheduled, done, or dead job, and refuses a leased one\"", "hash": "582d7365c60d2a42" },
        { "id": "b2736d14fa3f", "name": "test \"a listing filters by queue and by state, by id, and holds at most 100\"", "hash": "2049858482817da6" },
        { "id": "f32780c7163c", "name": "test \"the queues list every queue that holds a job, by name, and health's totals are their sums\"", "hash": "ce5b0b885ebfa174" },
        { "id": "d4c5a469be59", "name": "test \"a folder's records are ill-formed at the first key whose record breaks a rule\"", "hash": "5e29d6dc951ca8f2" },
        { "id": "5d887d971ff3", "name": "test \"a board rebuilt from its records holds the same jobs, leases, counts, and next number\"", "hash": "7a13397c62c167f3" },
        { "id": "7538e6a83c31", "name": "test \"a board rebuilt from the records the previous version wrote holds every job with its state\"", "hash": "9cd5a5b267f73ce5" },
        { "id": "65e800766d29", "name": "test \"a board's snapshot rebuilds the same board\"", "hash": "5b0620bbdc9aefa3" },
        { "id": "d8fa7decc95c", "name": "test \"a second create with a key answers the job the key names in every state, and writes nothing\"", "hash": "bee96ad4b331f6c6" },
        { "id": "efdf6a54ca5a", "name": "test \"a deleted job frees its key, and the next create with it makes a new job\"", "hash": "07eee9c99ee37fe8" },
        { "id": "e97dca7a678e", "name": "test \"a listing by key finds the one job its queue and key name, archived or not\"", "hash": "f913b9cd559f437e" },
        { "id": "d954e0cc980c", "name": "test \"the archive move takes each done or dead job at least retain_ms old, and nothing younger\"", "hash": "5f8857d7a9987ea2" },
        { "id": "7226504a547e", "name": "test \"a lease that runs out on its last try is archived once it is old, from the same look\"", "hash": "fca59da3c8803a3f" },
        { "id": "b17142a2d7c0", "name": "test \"an archived job reads by id, refuses a retry or a settle, and a delete frees its key\"", "hash": "2b6761e86af455f1" },
        { "id": "d360644a28e2", "name": "test \"the key map and the archive are rebuilt from the records, and a job in both files is archived\"", "hash": "da4a025b186341bb" },
        { "id": "9100bdf096dd", "name": "test \"archive changes on disk from a batch the live log refused move the durable board too\"", "hash": "2f740fd858ef4ae2" },
        { "id": "58b823c1abb1", "name": "test \"the ids counter stays above the archive's jobs, and a new board numbers past them\"", "hash": "586da46cddae68a8" },
