        { "id": "aaf6953546d9", "name": "fn pair_of", "hash": "dd5c7e8e381dde8a" },
        { "id": "9c9b42dd3084", "name": "test \"each status comes back over the wire, unless a call fails or the log did not take it\"", "hash": "5c1ad7fe2b34da39" },
        { "id": "ef52a41b91d4", "name": "test \"a store that cannot be written answers writes 503 over the wire and keeps answering reads\"", "hash": "20529d9428612bf3" },
        { "id": "6a45666e83ff", "name": "test \"the queues route lists each queue's jobs by state over the wire\"", "hash": "f3740fe22374521e" },
        { "id": "516772dedd6d", "name": "test \"two workers race over the wire for one job, and at most one of them holds it\"", "hash": "3d412504d75de9d6" },
        { "id": "c62549d8ebb6", "name": "test \"1,200 connections that send nothing do not stop a producer's request from being answered\"", "hash": "87bf6d856ca6cc5a" },
        { "id": "39afedd44fec", "name": "test \"over the wire, every answer is right or 503, and every job ends done once faults stop\"", "hash": "25e337661ab32889" },
        { "id": "fda5e0710c5d", "name": "test \"health counts the restarts since the service started, none at first\"", "hash": "2e560779e6f9b2cc" },
        { "id": "a5981923e939", "name": "test \"over the wire, a second create with a key is 200 with the first job, and a bad key is 400\"", "hash": "00f8d87693ed0260" },
        { "id": "f031ea449e42", "name": "test \"over the wire, a job done longer ago than the retention is archived, read by id, and 409 to a retry\"", "hash": "596af8967a3b4d54" },
        { "id": "77128d610aab", "name": "test rejects \"over the wire, with the chaos switch on, every answer is 2xx, 4xx, or 503 while the queue fails and comes back\"", "hash": "ecc90e5d95d3375e" }
      ],
