        { "id": "67a16f5ebe93", "name": "test \"a folder with no log opens empty, and a slow one says so\"", "hash": "786083107c7923c2" },
        { "id": "048633c10bd0", "name": "test \"the journal appends each line to its file, and counts the bytes it appended\"", "hash": "c66ce8dc23ebcc46" },
        { "id": "f5a69d37d220", "name": "test \"a log read back replays to the keys the store had\"", "hash": "6dd87d66deedbe73" },
        { "id": "45f1f7f1dd4d", "name": "test rejects \"a key with a space in it\"", "hash": "e8d49573ab2ebb12" },
