        { "id": "4fb692ffcd32", "name": "test \"each route takes its methods, and any other is 405 with the ones it takes\"", "hash": "dffccc769b4aecc4" },
        { "id": "eb9ea1ecbfa5", "name": "test \"a route that does not exist is 404, whatever its method or token\"", "hash": "6be17d4a1b03ceff" },
        { "id": "282a953fa3b5", "name": "test \"a missing, empty, or malformed token is 401; health needs none, and the scheme's case does not matter\"", "hash": "ab299f248347c8e6" },
        { "id": "2e2517971b92", "name": "test \"each route becomes its call\"", "hash": "a7e6d36bddac17c6" },
