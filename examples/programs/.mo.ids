        { "id": "a7b49f75a556", "name": "fn lost_answer", "hash": "7ba4704924050552" },
        { "id": "71786ad27940", "name": "fn keyed", "hash": "e2bac12097eed961" },
        { "id": "ec40e63f4323", "name": "fn done_board", "hash": "b65df0e1889c8383" },
        { "id": "a48139e3a679", "name": "fn written_whole", "hash": "50ed9aef85a6456d" },
        { "id": "b6cc26b1e304", "name": "fn each_kept_once", "hash": "263feba289205c89" },
        { "id": "0ce98dbc9e1f", "name": "fn held_once?", "hash": "3b841d5a4a119220" },
        { "id": "59fa700e8a7b", "name": "test \"a call through the queue is answered once its record is in the log\"", "hash": "e56ca99b45307c74" },
        { "id": "f074702438a5", "name": "test \"a job made with a delay is in the log as scheduled, and is not leased before its run_at\"", "hash": "d60c02d59a362bc2" },
        { "id": "b5160c7eff37", "name": "test \"a scheduled job is queued once the clock passes its run_at, and is leased with tries at 1\"", "hash": "3d2643b0c654bd8f" },
        { "id": "28c1813faaa6", "name": "test \"a batch the log did not take is 503, and the board goes back to what the store holds\"", "hash": "5f72f47118edb9c6" },
        { "id": "29e19f181f9f", "name": "test \"a log that cannot be written answers its writes 503, answers reads, and takes the next batch\"", "hash": "9b2e037350f038c1" },
        { "id": "2754ae6c0662", "name": "test \"a queue started again from its log finds a lease that ran out and hands the job out again\"", "hash": "247edf477787773f" },
        { "id": "06b008e57426", "name": "test \"a queue started on a log the previous version wrote replays every job and writes the new names\"", "hash": "6ca75d1ab674eb2e" },
        { "id": "6b9b982e995f", "name": "test \"every answer is right or 503 with the store unchanged, and every job ends done or dead once faults stop\"", "hash": "8e036d6c961cc1cd" },
        { "id": "d98c30ea48b4", "name": "test \"a second create with a key is answered with the first job, after a restart too, and a delete frees it\"", "hash": "98d7cbb3c2a67ad8" },
        { "id": "bc82268308bf", "name": "test \"a batch writes the archive before the log, and a log that refuses after the archive took leaves the job archived\"", "hash": "2c9e0b0c60c55b14" },
        { "id": "2d7711a8e8c6", "name": "test \"an archive that refuses the move writes nothing to the log, and a torn one is written whole next time\"", "hash": "f315ad86d6cf83ec" },
        { "id": "120f9b15b9f0", "name": "test \"a deleted archived job is a tombstone in the archive, and its stale live record stays gone\"", "hash": "e91a3687ae503b49" },
        { "id": "9b2b86d2cd4c", "name": "test \"a queue opened on a job in both files counts it once, archived, and reads it by id\"", "hash": "435789fea690d7ee" },
        { "id": "63c76cbc316e", "name": "test \"under faults, old done jobs move to the archive and each is kept exactly once\"", "hash": "453561f56e5e7e87" },
        { "id": "3b36936f0af7", "name": "test \"a failure inside the window spends a budget whose restarts are all inside it, and one after it does not\"", "hash": "a47523d6645da030" },
        { "id": "dcf562e123d1", "name": "test \"the chaos switch comes round on every N-th write, once for a batch that passes it, and never at 0\"", "hash": "980d2d35f470d01a" },
        { "id": "91f12795b886", "name": "test \"a queue begun again rebuilds its board from the log, keeps its leases and ids, and counts the restart\"", "hash": "b0c1efd7c4b42f69" },
        { "id": "1ce9706e94f7", "name": "test \"a queue not yet begun writes nothing, and answers every call 503, a kept one once it begins\"", "hash": "5406790d55ea73f8" },
        { "id": "3c8557586cd4", "name": "test rejects \"the chaos switch fails the queue once its third write is on disk\"", "hash": "954e686a533ae7ff" },
        { "id": "ad60ebb1a349", "name": "test rejects \"under faults, the chaos switch fails the queue at a seventh write in the middle of the workers' rounds\"", "hash": "e3ba08b89f1ca06d" }
      ],
      "verified": { "hash": "46d3f6b3ac93b4b4", "declarations": "7f4f6d05dbf133b6", "uses": [{ "module": "Jobq.Api", "hash": "b856961e572c8280" }, { "module": "Jobq.Board", "hash": "19f05293bb139adb" }, { "module": "Jobq.Job", "hash": "99567146a38a25dc" }, { "module": "Jobq.Store", "hash": "dc505a18252f99c0" }] }
    },
