200 {"jobs": [{"id": "j_1", "queue": "emails", "state": "done", "payload": "welcome ada", "attempts": 1, "max_attempts": 3, "created_at": "<created_at>", "updated_at": "<updated_at>"}, {"id": "j_2", "queue": "emails", "state": "queued", "payload": "welcome grace", "attempts": 1, "max_attempts": 2, "created_at": "<created_at>", "updated_at": "<updated_at>"}, {"id": "j_3", "queue": "reports", "state": "leased", "payload": "weekly", "attempts": 1, "max_attempts": 1, "created_at": "<created_at>", "updated_at": "<updated_at>", "worker": "w-slow", "lease_until": "<lease_until>"}, {"id": "j_4", "queue": "emails", "state": "queued", "payload": "line one\nline two \"quoted\" é", "attempts": 0, "max_attempts": 2, "created_at": "<created_at>", "updated_at": "<updated_at>"}]}
