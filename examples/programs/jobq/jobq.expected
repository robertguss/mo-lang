400 {"error": "state must be queued, leased, done, or dead"}
> p GET /jobs/j_1
200 {"id": "j_1", "queue": "emails", "state": "done", "payload": "welcome ada", "attempts": 1, "max_attempts": 3, "created_at": "<created_at>", "updated_at": "<updated_at>"}
