200 {"id": "j_4", "queue": "emails", "state": "leased", "payload": "line one\nline two \"quoted\" é", "attempts": 1, "max_attempts": 2, "created_at": "<created_at>", "updated_at": "<updated_at>", "worker": "w2", "lease_until": "<lease_until>"}
