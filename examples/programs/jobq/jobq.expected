201 {"id": "j_1000", "queue": "emails", "state": "queued", "payload": "hello \"world\"\nline two é", "attempts": 0, "max_attempts": 2, "created_at": "<created_at>", "updated_at": "<updated_at>"}
> p POST /jobs {"queue": "emails", "payload": "no attempts"}
400 {"error": "max_attempts is missing"}
> p POST /jobs {"queue": "a b", "payload": "", "max_attempts": 1}
400 {"error": "queue must be 1 to 64 letters, digits, - or _"}
> p POST /jobs {"queue": "emails", "payload": "", "max_attempts": 101}
400 {"error": "max_attempts must be a whole number from 1 to 100"}
> p POST /jobs this is not json
400 {"error": "the body is not JSON"}
> w1 POST /queues/emails/lease {"lease_ms": 60000}
200 {"id": "j_2", "queue": "emails", "state": "leased", "payload": "welcome grace", "attempts": 2, "max_attempts": 2, "created_at": "<created_at>", "updated_at": "<updated_at>", "worker": "w1", "lease_until": "<lease_until>"}
