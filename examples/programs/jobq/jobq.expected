200 {"jobs": [{"id": "j_2", "queue": "emails", "state": "queued", "payload": "welcome grace", "attempts": 1, "max_attempts": 2, "created_at": "<created_at>", "updated_at": "<updated_at>"}, {"id": "j_4", "queue": "emails", "state": "queued", "payload": "line one\nline two \"quoted\" é", "attempts": 0, "max_attempts": 2, "created_at": "<created_at>", "updated_at": "<updated_at>"}]}
