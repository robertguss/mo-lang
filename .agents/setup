#!/usr/bin/env bash
set -euo pipefail

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
SECONDS=0

echo '==> Checking system prerequisites'
missing=()
for package in ca-certificates curl xz-utils python3; do
  if [[ "$(dpkg-query -W -f='${Status}' "$package" 2>/dev/null || true)" != 'install ok installed' ]]; then
    missing+=("$package")
  fi
done
if ((${#missing[@]})); then
  sudo apt-get update
  sudo env DEBIAN_FRONTEND=noninteractive apt-get install -y "${missing[@]}"
fi
echo "==> System prerequisites ready (${SECONDS}s elapsed)"

# Match toolchain/build.zig.zon's minimum version. Checksums are from
# https://ziglang.org/download/index.json; update them when changing Zig.
version=0.16.0
case "$(uname -m)" in
  x86_64)
    arch=x86_64
    checksum=70e49664a74374b48b51e6f3fdfbf437f6395d42509050588bd49abe52ba3d00
    ;;
  aarch64)
    arch=aarch64
    checksum=ea4b09bfb22ec6f6c6ceac57ab63efb6b46e17ab08d21f69f3a48b38e1534f17
    ;;
  *) echo 'Unsupported orb architecture' >&2; exit 1 ;;
esac
zig_dir="/opt/zig-${arch}-linux-${version}"
if [[ ! -x "$zig_dir/zig" ]] || [[ "$("$zig_dir/zig" version)" != "$version" ]]; then
  echo "==> Installing Zig $version"
  tmp="$(mktemp -d)"
  trap 'rm -rf -- "$tmp"' EXIT
  curl --fail --location --retry 3 --connect-timeout 15 --max-time 180 \
    "https://ziglang.org/download/${version}/zig-${arch}-linux-${version}.tar.xz" \
    --output "$tmp/zig.tar.xz"
  echo "$checksum  $tmp/zig.tar.xz" | sha256sum --check
  tar -xJf "$tmp/zig.tar.xz" -C "$tmp"
  sudo mkdir -p "$zig_dir"
  sudo cp -a "$tmp/zig-${arch}-linux-${version}/." "$zig_dir/"
fi
sudo ln -sfn "$zig_dir/zig" /usr/local/bin/zig
echo "==> Zig $(/usr/local/bin/zig version) ready (${SECONDS}s elapsed)"

# Zig's own cache handles unchanged sources on stale snapshots. No package
# dependencies, environment files, credentials, or backing services are needed.
echo '==> Building Mo and warming the Zig build cache'
export PATH="/usr/local/bin:$PATH"
(
  cd -- "$repo_root/toolchain"
  zig build --summary all
)
sudo ln -sfn "$repo_root/toolchain/zig-out/bin/mo" /usr/local/bin/mo
echo "==> Orb setup finished (${SECONDS}s elapsed)"
